<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <%= render "shared/logo", variant: :mark, size: 40 %>
        <p class="body-sm muted"><%= placeholder_text %></p>
        <div class="site-footer__badges">
          <a class="tag tag--mint" href="#"><%= placeholder_text %></a>
          <a class="tag tag--peach" href="#"><%= placeholder_text %></a>
        </div>
      </div>

      <% WelcomeHelper::FOOTER_COLUMN_COUNT.times do |index| %>
        <nav class="site-footer__column" aria-label="Footer column <%= index + 1 %>">
          <h2 class="site-footer__heading"><%= placeholder_text %></h2>
          <ul>
            <% 4.times do %>
              <li><a href="#"><%= placeholder_text %></a></li>
            <% end %>
          </ul>
        </nav>
      <% end %>
    </div>

    <div class="site-footer__bottom">
      <p class="body-sm muted"><%= placeholder_text %></p>
      <ul class="site-footer__legal">
        <% 3.times do %>
          <li><a href="#"><%= placeholder_text %></a></li>
        <% end %>
      </ul>
    </div>
  </div>
</footer>
